# Development environment variables
# Copy from .env.example or .env.production and customize

# Django Settings
DEBUG=False
SECRET_KEY=your-development-secret-key-change-in-production-12345678901234
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Database Configuration - Using PostgreSQL by default
DATABASE_ENGINE=django.db.backends.postgresql
POSTGRES_DB=amazon_clone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432

# Redis Configuration
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000,http://127.0.0.1:3000

# Frontend API URL
VITE_API_URL=http://localhost:8000

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017

# Email Configuration (optional - console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
