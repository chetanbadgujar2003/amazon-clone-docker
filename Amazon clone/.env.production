# Production environment variables for Docker Compose
# Copy to .env and update with your production values

# Django Settings
DEBUG=False
SECRET_KEY=your-production-secret-key-minimum-50-characters-1234567890abcdefghijklmno
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Database Configuration - PostgreSQL
DATABASE_ENGINE=django.db.backends.postgresql
POSTGRES_DB=amazon_clone_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_strong_password_12345
DATABASE_HOST=postgres
DATABASE_PORT=5432

# Redis Configuration
REDIS_PASSWORD=change_me_to_strong_redis_password_xyz
REDIS_URL=redis://:change_me_to_strong_redis_password_xyz@redis:6379/0

# CORS Configuration for Production
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend API URL (update to your production domain)
VITE_API_URL=https://api.yourdomain.com

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Email Configuration for Production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
