# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production-12345678901234567890
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Database Configuration - PostgreSQL (Recommended for Production)
DATABASE_ENGINE=django.db.backends.postgresql
POSTGRES_DB=amazon_clone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
DATABASE_HOST=postgres
DATABASE_PORT=5432

# MongoDB Configuration (Optional - comment out if not using)
# MONGODB_URI=mongodb://root:example@mongo:27017/amazon_clone?authSource=admin
# MONGODB_NAME=amazon_clone

# Redis Configuration
REDIS_PASSWORD=redis_password_change_this
REDIS_URL=redis://:redis_password_change_this@redis:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000,https://yourdomain.com

# Frontend API URL
VITE_API_URL=http://localhost:8000

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
